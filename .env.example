# GEMINI_API_KEY: Optional for AI features if enabled later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_CLAIM_PASSCODE: Optional server passcode to claim Platform/Super Admin role.
# If left empty, the first-run inline Admin Setup form in the UI allows claiming admin once.
ADMIN_CLAIM_PASSCODE=

# SESSION_SECRET: Optional HMAC secret for signing session cookies/tokens.
SESSION_SECRET=
